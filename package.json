{
  "name": "pi-unstall",
  "version": "0.1.0",
  "description": "Pi extension that notices when an agent run stopped without finishing - provider error, truncated response, or a model that trailed off mid-sentence - and nudges it back into motion with a continue message.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "unstall",
    "auto-continue",
    "recovery",
    "resilience",
    "stall",
    "retry"
  ],
  "license": "MIT",
  "author": "zeroicey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroicey/pi-unstall.git"
  },
  "homepage": "https://github.com/zeroicey/pi-unstall#readme",
  "bugs": {
    "url": "https://github.com/zeroicey/pi-unstall/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:package": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0"
  }
}
